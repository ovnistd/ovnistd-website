---
interface Props { tag: string; title: string; sub?: string; center?: boolean; as?: 'h1' | 'h2' }
const { tag, title, sub, center = false, as: Tag = 'h2' } = Astro.props;
const lines = title.split('\n');
---
<div class:list={['section-head', { 'section-head--center': center }]} data-reveal>
  <span class="tag"><span class="tag__dot"></span>{tag}</span>
  <Tag class={Tag === 'h1' ? 'display' : 'h2'}>{lines.map((l, i) => <>{l}{i < lines.length - 1 && <br />}</>)}</Tag>
  {sub && <p class="lead">{sub}</p>}
  <slot />
</div>
