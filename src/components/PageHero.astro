---
import { href, type Lang } from '../i18n';
interface Props { lang: Lang; tag: string; title: string; sub?: string; crumbs?: Array<{ label: string; path: string }> }
const { lang, tag, title, sub, crumbs = [] } = Astro.props;
const home = lang === 'fr' ? 'Accueil' : 'Home';
const lines = title.split('\n');
---
<section class="page-hero">
  <div class="grid-bg"></div>
  <div class="glow" style="width:800px;height:600px;right:-200px;top:-260px"></div>
  <div class="container">
    {crumbs.length > 0 && (
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={href('/', lang)}>{home}</a>
        {crumbs.map((c) => <><span>/</span><a href={href(c.path, lang)}>{c.label}</a></>)}
      </nav>
    )}
    <span class="tag" style="justify-self:start"><span class="tag__dot"></span>{tag}</span>
    <h1 class="display">{lines.map((l, i) => <>{l}{i < lines.length - 1 && <br />}</>)}</h1>
    {sub && <p class="lead">{sub}</p>}
    <slot />
  </div>
</section>
