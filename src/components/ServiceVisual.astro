---
// Small CSS illustrations inside each service card, echoing the reference's bento visuals.
import Product3D from './Product3D.astro';
interface Props { kind: string; lang?: 'en' | 'fr' }
const { kind, lang = 'en' } = Astro.props;
---
<div class={`sv sv--${kind}`} aria-hidden="true">
  {kind === 'web' && (
    <>
      <div class="sv-browser">
        <div class="sv-browser__bar"><i></i><i></i><i></i><span>ovnistudio.net</span></div>
        <div class="sv-browser__body"><b></b><em></em><em class="s"></em><div class="sv-browser__btns"><u></u><u></u></div></div>
      </div>
      <div class="sv-pills"><span>Shopify</span><span>3D visuals</span><span>Fast checkout</span><span>Upsells</span></div>
    </>
  )}
  {kind === 'brand' && (
    <div class="sv-brand"><span class="aa">Aa</span><div class="sw"><i></i><i></i><i></i><i></i></div></div>
  )}
  {kind === 'design' && (
    <div class="sv-posters"><i></i><i></i><i></i></div>
  )}
  {kind === 'media' && (
    <div class="sv-media">
      <div class="sv-media__screen"><span class="play"></span><span class="rec">● REC</span></div>
      <div class="sv-media__wave">{Array.from({ length: 48 }, (_, i) => <i style={`height:${18 + Math.round(Math.abs(Math.sin(i * 0.7) * Math.cos(i * 0.23)) * 70)}%`}></i>)}</div>
    </div>
  )}
  {kind === 'cube' && (
    <div class="sv-product"><Product3D /></div>
  )}
  {kind === 'ai' && (
    <div class="sv-ai">
      <div class="prompt">✦ a hand holding the serum bottle, golden hour, UGC style</div>
      <div class="thumbs"><i></i><i></i><i></i></div>
    </div>
  )}
</div>
<style>
  .sv { position: relative; height: 100%; min-height: 170px; display: grid; place-items: center; }
  /* web */
  .sv-browser { width: min(380px, 92%); border-radius: 12px; border: 1px solid var(--line-2); background: linear-gradient(180deg, #1d1630, #0f0b18); box-shadow: 0 20px 40px -20px #000, inset 0 1px 0 rgba(255,255,255,.08); transform: perspective(900px) rotateX(10deg) rotateY(-12deg); }
  .sv-browser__bar { display: flex; gap: 5px; align-items: center; padding: 9px 12px; border-bottom: 1px solid var(--line); font-size: 10px; color: var(--text-3); }
  .sv-browser__bar i { width: 7px; height: 7px; border-radius: 50%; background: #3a2f52; }
  .sv-browser__bar span { margin-left: 10px; padding: 2px 10px; border-radius: 6px; background: rgba(255,255,255,.04); }
  .sv-browser__body { padding: 18px; display: grid; gap: 8px; }
  .sv-browser__body b { height: 14px; width: 70%; border-radius: 4px; background: linear-gradient(90deg, #fff, #a993e0); }
  .sv-browser__body em { height: 6px; width: 85%; border-radius: 3px; background: rgba(255,255,255,.12); }
  .sv-browser__body em.s { width: 55%; }
  .sv-browser__btns { display: flex; gap: 6px; margin-top: 6px; }
  .sv-browser__btns u { width: 54px; height: 16px; border-radius: 5px; background: #fff; }
  .sv-browser__btns u + u { background: #2a2140; border: 1px solid var(--line-2); }
  .sv-pills { position: absolute; bottom: 4px; left: 0; right: 0; display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; }
  .sv-pills span { font-size: 11px; padding: 4px 10px; border-radius: 999px; background: rgba(18,14,28,.9); border: 1px solid var(--line-2); color: var(--text-2); }
  /* brand */
  .sv-brand { display: grid; gap: 16px; justify-items: center; }
  .aa { font-size: 72px; font-weight: 600; letter-spacing: -0.05em; line-height: 1; background: linear-gradient(160deg, #fff 10%, #8e6cef 60%, #2a1550); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .sw { display: flex; }
  .sw i { width: 38px; height: 38px; border-radius: 50%; margin-left: -8px; border: 2px solid #120e1c; }
  .sw i:nth-child(1) { background: #f4f1fa; } .sw i:nth-child(2) { background: #c9b8f5; } .sw i:nth-child(3) { background: #8e6cef; } .sw i:nth-child(4) { background: #2a1550; }
  /* design */
  .sv-posters { position: relative; width: 200px; height: 160px; }
  .sv-posters i { position: absolute; width: 104px; height: 140px; border-radius: 10px; border: 1px solid var(--line-2); top: 10px; left: 48px; box-shadow: 0 16px 30px -12px #000; }
  .sv-posters i:nth-child(1) { transform: rotate(-14deg) translateX(-40px); background: linear-gradient(160deg, #2a1550, #120e1c); }
  .sv-posters i:nth-child(2) { transform: rotate(10deg) translateX(40px); background: linear-gradient(160deg, #c9b8f5, #4b2a8a); }
  .sv-posters i:nth-child(3) { background: radial-gradient(circle at 50% 40%, #fff 0 14%, transparent 15%), linear-gradient(180deg, #8e6cef, #1a1428); }
  /* media */
  .sv-media { width: min(420px, 92%); display: grid; gap: 12px; }
  .sv-media__screen { position: relative; height: 120px; border-radius: 12px; border: 1px solid var(--line-2); background: radial-gradient(circle at 70% 30%, rgba(142,108,239,.55), transparent 55%), linear-gradient(135deg, #1d1630, #08060d); display: grid; place-items: center; }
  .play { width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,.92); position: relative; box-shadow: 0 0 30px rgba(142,108,239,.7); }
  .play::after { content: ''; position: absolute; left: 17px; top: 13px; border-left: 13px solid #120e1c; border-top: 9px solid transparent; border-bottom: 9px solid transparent; }
  .rec { position: absolute; top: 10px; left: 12px; font-size: 10px; color: #ff8fa3; letter-spacing: .08em; }
  .sv-media__wave { height: 36px; display: flex; align-items: center; gap: 3px; }
  .sv-media__wave i { flex: 1; border-radius: 2px; background: linear-gradient(180deg, #c9b8f5, #4b2a8a); }
  /* 3D product */
  .sv-product { width: 100%; height: 100%; min-height: 230px; align-self: stretch; }
  /* ai */
  .sv-ai { display: grid; gap: 12px; width: min(300px, 92%); }
  .prompt { font-size: 12px; color: var(--text-2); padding: 10px 14px; border-radius: 10px; border: 1px solid var(--line-2); background: rgba(18,14,28,.9); box-shadow: 0 0 0 4px rgba(142,108,239,.08); }
  .thumbs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .thumbs i { aspect-ratio: 1; border-radius: 8px; border: 1px solid var(--line); }
  .thumbs i:nth-child(1) { background: radial-gradient(circle at 50% 35%, #e9e2fb 0 12%, transparent 13%), linear-gradient(180deg, #4b2a8a, #1a0f2e 60%, #8e6cef); }
  .thumbs i:nth-child(2) { background: radial-gradient(ellipse at 50% 45%, #fff 0 10%, transparent 11%), linear-gradient(180deg, #120e1c, #6a3fd0); }
  .thumbs i:nth-child(3) { background: radial-gradient(circle at 30% 30%, #c9b8f5, transparent 40%), linear-gradient(200deg, #2a1550, #0c0913); }
</style>
<style>
  @media (max-width: 600px) { .sv--web { display: flex; flex-direction: column; gap: 16px; } .sv-pills { position: static; } }
</style>
