---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { ui, t, href, altPath, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const links = [
  { label: ui.nav.services, path: '/services' },
  { label: ui.nav.work, path: '/work' },
  { label: ui.nav.about, path: '/about' },
  { label: ui.nav.contact, path: '/contact' },
];
const other = altPath(Astro.url.pathname, lang);
---
<header class="nav" data-nav>
  <div class="container nav__inner">
    <a href={href('/', lang)} aria-label="Ovnistudio home"><Logo size={46} word={false} /></a>
    <nav class="nav__links" aria-label="Main">
      {links.map((l) => <a href={href(l.path, lang)}>{t(l.label, lang)}</a>)}
    </nav>
    <div class="nav__right">
      <a class="nav__lang" href={other} hreflang={lang === 'en' ? 'fr' : 'en'} aria-label={lang === 'en' ? 'Version française' : 'English version'}>
        <span class:list={{ on: lang === 'en' }}>EN</span><span class="sep">/</span><span class:list={{ on: lang === 'fr' }}>FR</span>
      </a>
      <a class="btn btn--primary btn--sm nav__cta" href={href('/contact', lang)}>
        {t(ui.nav.cta, lang)} <span class="btn__icon"><Icon name="arrow-up-right" size={10} /></span>
      </a>
      <button class="nav__burger" aria-label={t(ui.nav.menu, lang)} aria-expanded="false" data-burger><Icon name="menu" /></button>
    </div>
  </div>
  <div class="nav__sheet" data-sheet>
    {links.map((l) => <a href={href(l.path, lang)}>{t(l.label, lang)}</a>)}
    <a class="btn btn--primary" href={href('/contact', lang)}>{t(ui.nav.cta, lang)}</a>
  </div>
</header>

<style>
  .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; transition: background 0.3s, border-color 0.3s, backdrop-filter 0.3s; border-bottom: 1px solid transparent; }
  .nav.is-scrolled { background: rgba(7, 6, 11, 0.72); backdrop-filter: blur(16px) saturate(140%); -webkit-backdrop-filter: blur(16px) saturate(140%); border-color: var(--line); }
  .nav__inner { height: 72px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
  .nav__links { display: flex; gap: 32px; font-size: 14px; color: var(--text-2); }
  .nav__links a:hover { color: var(--text); }
  .nav__right { display: flex; justify-content: flex-end; align-items: center; gap: 20px; }
  .nav__lang { font-size: 13px; color: var(--text-3); display: flex; gap: 4px; }
  .nav__lang .on { color: var(--text); }
  .nav__lang:hover span { color: var(--text-2); }
  .nav__burger { display: none; background: none; border: 1px solid var(--line-2); border-radius: 8px; width: 36px; height: 34px; place-items: center; }
  .nav__sheet { display: none; }
  @media (max-width: 860px) {
    .nav__inner { grid-template-columns: 1fr auto; }
    .nav__links, .nav__cta { display: none; }
    .nav__burger { display: grid; }
    .nav__right { gap: 14px; }
    .nav__sheet { display: grid; gap: 4px; padding: 8px 16px 20px; background: rgba(7, 6, 11, 0.96); border-bottom: 1px solid var(--line); max-height: 0; overflow: hidden; padding-top: 0; padding-bottom: 0; transition: max-height 0.4s var(--ease), padding 0.4s var(--ease); }
    .nav__sheet a:not(.btn) { padding: 12px 4px; font-size: 18px; border-bottom: 1px solid var(--line); }
    .nav__sheet .btn { margin-top: 12px; justify-content: center; }
    .nav.is-open .nav__sheet { max-height: 420px; padding-top: 8px; padding-bottom: 20px; }
    .nav.is-open { background: rgba(7, 6, 11, 0.96); }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  const burger = nav.querySelector<HTMLButtonElement>('[data-burger]')!;
  burger.addEventListener('click', () => {
    const open = nav.classList.toggle('is-open');
    burger.setAttribute('aria-expanded', String(open));
  });
</script>
