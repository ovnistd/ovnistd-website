---
import Icon from './Icon.astro';
import Chrome3D from './Chrome3D.astro';
import { ui, t, href, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="section cta">
  <div class="container">
    <div class="cta__card card" data-reveal>
      <div class="grid-bg"></div>
      <div class="cta__glow"></div>
      <div class="cta__text">
        <h2 class="h2">{t(ui.sections.cta.title1, lang)}<br />{t(ui.sections.cta.title2, lang)}</h2>
        <p class="lead">{t(ui.sections.cta.sub, lang)}</p>
        <div class="cta__btns">
          <a class="btn btn--primary" href={href('/contact', lang)}>{t(ui.hero.cta1, lang)} <span class="btn__icon"><Icon name="half" size={10} /></span></a>
          <a class="btn btn--ghost" href={href('/work', lang)}>{t(ui.sections.work.all, lang)} <Icon name="play" size={12} /></a>
        </div>
      </div>
      <div class="cta__3d"><Chrome3D variant="hero" /></div>
    </div>
  </div>
</section>
<style>
  .cta__card { display: grid; grid-template-columns: 1.4fr 1fr; align-items: center; padding: 72px 64px; border-radius: 24px; min-height: 380px; }
  .cta__glow { position: absolute; right: -10%; top: -40%; width: 70%; height: 180%; background: radial-gradient(circle, rgba(91, 46, 170, 0.5), transparent 60%); filter: blur(40px); pointer-events: none; }
  .cta__text { position: relative; z-index: 1; display: grid; gap: 20px; }
  .cta__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .cta__3d { position: absolute; right: 0; top: 0; bottom: 0; width: 45%; z-index: 0; }
  @media (max-width: 860px) {
    .cta__card { grid-template-columns: 1fr; padding: 48px 24px 260px; }
    .cta__3d { width: 100%; top: auto; height: 260px; }
  }
</style>
