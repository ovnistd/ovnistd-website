---
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import { studio } from '../../data/site';
import { logoPath, logoViewBox } from '../../data/logo';
import { ui, t, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;

/** Turn a YouTube or Vimeo link into an embeddable player URL. */
function toEmbed(url: string): string {
  if (!url) return '';
  const yt = url.match(/(?:youtube\.com\/(?:watch\?v=|shorts\/|embed\/)|youtu\.be\/)([\w-]{6,})/);
  if (yt) return `https://www.youtube-nocookie.com/embed/${yt[1]}?autoplay=1&rel=0&modestbranding=1`;
  const vm = url.match(/vimeo\.com\/(?:video\/)?(\d+)/);
  if (vm) return `https://player.vimeo.com/video/${vm[1]}?autoplay=1&title=0&byline=0&portrait=0`;
  return '';
}
const embed = toEmbed(studio.introVideo);
const s = ui.sections.intro;
---
<section class="section intro" id="intro">
  <div class="glow" style="width:900px;height:600px;left:50%;top:20%;transform:translateX(-50%)"></div>
  <div class="container">
    <SectionHead tag={t(s.tag, lang)} title={t(s.title, lang)} sub={t(s.sub, lang)} center />
    <div class="player card" data-reveal data-player data-embed={embed}>
      <div class="grid-bg"></div>
      <svg class="player__mark" viewBox={logoViewBox} aria-hidden="true">
        <defs>
          <linearGradient id="intro-chrome" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#ffffff" stop-opacity=".9" />
            <stop offset=".5" stop-color="#8e6cef" stop-opacity=".35" />
            <stop offset="1" stop-color="#2a1550" stop-opacity=".2" />
          </linearGradient>
        </defs>
        <path fill="url(#intro-chrome)" fill-rule="evenodd" d={logoPath} />
      </svg>
      <button class="player__btn" type="button" disabled={!embed} aria-label={t(s.play, lang)}>
        <span class="player__play"><Icon name="play" size={26} /></span>
        <span class="player__label">{embed ? t(s.play, lang) : t(s.soon, lang)}</span>
      </button>
    </div>
  </div>
</section>
<style>
  .player { position: relative; z-index: 1; aspect-ratio: 16 / 9; max-width: 980px; margin: 0 auto; border-radius: 24px; display: grid; place-items: center; background: radial-gradient(70% 90% at 50% 0%, rgba(91,46,170,.45), transparent 60%), linear-gradient(180deg, #140e22, #07060b); }
  .player__mark { position: absolute; width: 62%; left: 19%; top: 18%; opacity: .55; filter: blur(.3px) drop-shadow(0 20px 60px rgba(142,108,239,.45)); pointer-events: none; }
  .player__btn { position: relative; z-index: 1; display: grid; justify-items: center; gap: 14px; background: none; border: 0; color: var(--text); }
  .player__btn:disabled { cursor: default; }
  .player__play { width: 84px; height: 84px; border-radius: 50%; display: grid; place-items: center; color: #120e1c; background: linear-gradient(180deg, #fff, #e2d9f8); box-shadow: 0 0 0 10px rgba(255,255,255,.06), 0 0 60px rgba(142,108,239,.8); transition: transform .3s var(--ease); }
  .player__btn:not(:disabled):hover .player__play { transform: scale(1.08); }
  .player__play :global(svg) { margin-left: 4px; }
  .player__label { font-size: 14px; color: var(--text-2); padding: 6px 14px; border-radius: 999px; background: rgba(7,6,11,.6); border: 1px solid var(--line-2); backdrop-filter: blur(8px); }
  .player iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; z-index: 2; }
  @media (max-width: 560px) { .player__play { width: 60px; height: 60px; } .player { border-radius: 16px; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((el) => {
    const url = el.dataset.embed;
    const btn = el.querySelector('button');
    if (!url || !btn) return;
    btn.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = url;
      f.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
      f.allowFullscreen = true;
      f.title = 'Ovnistudio founder video';
      el.appendChild(f);
    });
  });
</script>
