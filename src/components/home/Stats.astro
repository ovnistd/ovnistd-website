---
import { stats, clients } from '../../data/site';
import { ui, t, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="stats">
  <div class="container">
    <h2 class="sr-only">{t(ui.sections.stats.tag, lang)}</h2>
    <div class="stats__panel" data-reveal>
      {stats.map((s) => (
        <div class="stat">
          <strong class="stat__value">{s.value}</strong>
          <span class="stat__label">{t(s.label, lang)}</span>
        </div>
      ))}
    </div>
  </div>
  <div class="marquee" aria-label="Clients">
    <div class="marquee__track">
      {[...clients, ...clients].map((c, i) => (
        <span class="marquee__item" aria-hidden={i >= clients.length ? 'true' : undefined}>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d={['M12 2l10 10-10 10L2 12z', 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 5a5 5 0 1 1 0 10 5 5 0 0 1 0-10z', 'M3 4h7v16H3zM14 4h7v7h-7zM14 13h7v7h-7z', 'M12 2l9 18H3z'][i % 4]} /></svg>
          {c}
        </span>
      ))}
    </div>
  </div>
</section>
<style>
  .stats { position: relative; padding: 24px 0 40px; }
  .stats__panel {
    display: grid; grid-template-columns: repeat(4, 1fr); border-radius: 20px; overflow: hidden;
    border: 1px solid var(--line-2);
    background: linear-gradient(180deg, rgba(34, 24, 56, 0.55), rgba(12, 10, 19, 0.85));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 30px 60px -30px rgba(0, 0, 0, 0.8);
  }
  .stat { padding: 36px 24px 32px; display: grid; gap: 10px; justify-items: center; align-content: start; text-align: center; }
  .stat + .stat { border-left: 1px solid var(--line-2); }
  .stat__value {
    font-size: clamp(38px, 4vw, 52px); font-weight: 500; letter-spacing: -0.04em; line-height: 1;
    background: linear-gradient(180deg, #fff, #c9b8f5); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .stat__label { color: var(--text-2); font-size: 14px; max-width: 220px; }
  .marquee { margin-top: 72px; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent); }
  .marquee__track { display: flex; width: max-content; animation: marquee 36s linear infinite; }
  .marquee:hover .marquee__track { animation-play-state: paused; }
  .marquee__item { display: inline-flex; align-items: center; gap: 10px; padding: 0 44px; font-size: 20px; font-weight: 600; letter-spacing: -0.03em; color: #cfc6e4; opacity: 0.75; white-space: nowrap; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (max-width: 900px) { .stats__panel { grid-template-columns: repeat(2, 1fr); } .stat:nth-child(3) { border-left: 0; } .stat:nth-child(n+3) { border-top: 1px solid var(--line-2); } }
</style>
