---
import SectionHead from '../SectionHead.astro';
import WorkCard from '../WorkCard.astro';
import Icon from '../Icon.astro';
import { cases } from '../../data/site';
import { ui, t, href, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const featured = cases.filter((c) => c.featured).slice(0, 6);
---
<section class="section">
  <div class="container">
    <div class="work__head">
      <SectionHead tag={t(ui.sections.work.tag, lang)} title={t(ui.sections.work.title, lang)} sub={t(ui.sections.work.sub, lang)} />
      <a class="btn btn--ghost" href={href('/work', lang)}>{t(ui.sections.work.all, lang)} <Icon name="arrow" size={14} /></a>
    </div>
    <div class="work-grid">
      {featured.map((c) => <WorkCard c={c} lang={lang} />)}
    </div>
  </div>
</section>
<style>
  .work__head { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 56px; }
  .work__head :global(.section-head) { margin: 0; }
  .work__head .btn { flex: none; }
  .work-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px 20px; }
  @media (max-width: 960px) { .work-grid { grid-template-columns: repeat(2, 1fr); } .work__head { flex-direction: column; align-items: start; } }
  @media (max-width: 600px) { .work-grid { grid-template-columns: 1fr; } }
</style>
