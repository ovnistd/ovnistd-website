---
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import { comparison } from '../../data/site';
import { ui, t, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="section section--band">
  <div class="glow" style="width:700px;height:500px;left:50%;top:30%;transform:translateX(-10%)"></div>
  <div class="container">
    <SectionHead tag={t(ui.sections.why.tag, lang)} title={t(ui.sections.why.title, lang)} sub={t(ui.sections.why.sub, lang)} center />
    <div class="vs">
      <div class="vs__col card" data-reveal>
        <div class="vs__head"><span class="vs__label">{t(ui.sections.why.typical, lang)}</span></div>
        <ul>
          {comparison.map((c) => <li><span class="ico ico--x"><Icon name="x" size={12} /></span>{t(c.typical, lang)}</li>)}
        </ul>
      </div>
      <div class="vs__col vs__col--studio" data-reveal style="transition-delay:120ms">
        <div class="vs__head"><span class="vs__label">{t(ui.sections.why.studio, lang)}</span><span class="vs__badge">✦</span></div>
        <ul>
          {comparison.map((c) => <li><span class="ico ico--ok"><Icon name="check" size={12} /></span>{t(c.studio, lang)}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
<style>
  .vs { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; position: relative; z-index: 1; max-width: 980px; margin: 0 auto; }
  .vs__col { padding: 32px; border-radius: 20px; }
  .vs__col--studio {
    position: relative; color: #120e1c;
    background: linear-gradient(180deg, #ffffff 0%, #ece6fb 100%);
    box-shadow: 0 0 0 1px rgba(255,255,255,.7) inset, 0 30px 80px -20px rgba(142,108,239,.55);
  }
  .vs__head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 20px; margin-bottom: 8px; border-bottom: 1px solid var(--line); }
  .vs__col--studio .vs__head { border-color: rgba(18,14,28,.1); }
  .vs__label { font-size: 20px; font-weight: 500; letter-spacing: -.02em; }
  .vs__col:not(.vs__col--studio) .vs__label { color: var(--text-2); }
  .vs__badge { width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; background: #120e1c; color: #c9b8f5; font-size: 13px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; }
  li { display: flex; align-items: center; gap: 12px; padding: 13px 0; font-size: 15px; border-bottom: 1px dashed var(--line); }
  li:last-child { border: 0; }
  .vs__col:not(.vs__col--studio) li { color: var(--text-3); }
  .vs__col--studio li { border-color: rgba(18,14,28,.1); }
  .ico { flex: none; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; }
  .ico--x { background: rgba(255,255,255,.05); border: 1px solid var(--line-2); color: var(--text-3); }
  .ico--ok { background: #120e1c; color: #c9b8f5; }
  @media (max-width: 760px) { .vs { grid-template-columns: 1fr; } }
</style>
