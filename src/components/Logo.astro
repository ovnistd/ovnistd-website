---
// PLACEHOLDER mark until the real Ovnistudio logo (SVG) is added.
import Icon from './Icon.astro';
---
<span class="logo">
  <span class="logo__mark"><Icon name="ufo" size={18} /></span>
  <span class="logo__word">Ovnistudio</span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; letter-spacing: -0.03em; font-size: 17px; }
  .logo__mark {
    width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center; color: #120e1c;
    background: linear-gradient(145deg, #fff 0%, #c9b8f5 30%, #5b3fa0 60%, #e9e2fb 85%);
    box-shadow: inset 0 1px 1px #fff, 0 4px 16px -4px rgba(142, 108, 239, 0.7);
  }
</style>
