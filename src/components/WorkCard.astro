---
import Icon from './Icon.astro';
import { services, type Case } from '../data/site';
import { t, href, type Lang } from '../i18n';
interface Props { c: Case; lang: Lang }
const { c, lang } = Astro.props;
const film = c.films[0];
const tags = c.services.slice(0, 2).map((s) => t(services.find((x) => x.slug === s)!.title, lang));
---
<a class="wc" href={href(`/work/${c.slug}`, lang)} data-reveal data-workcard>
  <div class="wc__media" style={`--h:${c.hue}`}>
    {c.thumbnail ? <img src={c.thumbnail} alt="" loading="lazy" /> : (
      <div class="wc__gen"><span>{c.brand}</span></div>
    )}
    {c.preview && <video src={c.preview} muted loop playsinline preload="none"></video>}
    <span class="wc__play"><Icon name="play" size={14} /></span>
    <span class="wc__dur">{film?.duration}</span>
  </div>
  <div class="wc__meta">
    <div>
      <h3 class="h3">{c.brand}</h3>
      <p class="muted small">{t(c.summary, lang)}</p>
    </div>
    <div class="wc__tags">{tags.map((x) => <span class="chip">{x}</span>)}</div>
  </div>
</a>
<style>
  .wc { display: grid; gap: 16px; }
  .wc__media { position: relative; aspect-ratio: 16 / 10; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: #0c0913; box-shadow: inset 0 1px 0 rgba(255,255,255,.06); }
  .wc__media img, .wc__media video, .wc__gen { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease), opacity .4s; }
  .wc__media video { opacity: 0; }
  .wc.is-playing video { opacity: 1; }
  .wc__gen {
    display: grid; place-items: center;
    background:
      radial-gradient(60% 80% at 75% 20%, hsl(var(--h) 70% 55% / .55), transparent 60%),
      radial-gradient(50% 60% at 15% 90%, hsl(var(--h) 60% 35% / .6), transparent 60%),
      linear-gradient(160deg, hsl(var(--h) 40% 12%), #07060b 70%);
  }
  .wc__gen::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(to right, rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,.05) 1px, transparent 1px); background-size: 40px 40px; mask-image: radial-gradient(circle at 50% 50%, #000, transparent 75%); }
  .wc__gen span { position: relative; font-size: clamp(28px, 4vw, 44px); font-weight: 600; letter-spacing: -.05em; background: linear-gradient(180deg, #fff, hsl(var(--h) 60% 75%)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .wc:hover .wc__media img, .wc:hover .wc__gen { transform: scale(1.04); }
  .wc__play { position: absolute; left: 16px; bottom: 16px; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,.92); color: #120e1c; box-shadow: 0 0 24px rgba(142,108,239,.6); transition: transform .3s var(--ease); }
  .wc:hover .wc__play { transform: scale(1.1); }
  .wc__dur { position: absolute; right: 14px; bottom: 16px; font-size: 12px; padding: 3px 8px; border-radius: 6px; background: rgba(7,6,11,.7); backdrop-filter: blur(6px); color: var(--text-2); }
  .wc__meta { display: grid; gap: 12px; }
  .wc__meta p { margin-top: 4px; }
  .wc__tags { display: flex; gap: 6px; flex-wrap: wrap; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-workcard]').forEach((card) => {
    const v = card.querySelector('video');
    if (!v) return;
    card.addEventListener('mouseenter', () => { v.play().then(() => card.classList.add('is-playing')).catch(() => {}); });
    card.addEventListener('mouseleave', () => { v.pause(); card.classList.remove('is-playing'); });
  });
</script>
