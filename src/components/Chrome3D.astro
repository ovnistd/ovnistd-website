---
import { hero3d } from '../data/hero3d';
interface Props { variant?: 'hero' | 'single'; class?: string }
const { variant = 'hero', class: cls } = Astro.props;
const mode = variant === 'single' ? 'single' : hero3d.mode;
---
<div class:list={['chrome3d', `chrome3d--${variant}`, cls]}>
  <canvas data-chrome3d data-mode={mode} data-src={mode === "svg" || mode === "glb" ? hero3d.src : undefined} aria-hidden="true"></canvas>
</div>

<style>
  .chrome3d { position: relative; width: 100%; height: 100%; opacity: 0; transition: opacity 1.2s var(--ease); }
  .chrome3d:global(.is-ready) { opacity: 1; }
  .chrome3d::after {
    content: ''; position: absolute; left: 15%; right: 15%; bottom: 4%; height: 18%; z-index: -1;
    background: radial-gradient(ellipse, rgba(142, 108, 239, 0.45), transparent 70%); filter: blur(24px);
  }
  canvas { width: 100%; height: 100%; }
</style>

<script>
  import { mountChrome } from '../scripts/chrome3d';
  const canvases = document.querySelectorAll<HTMLCanvasElement>('canvas[data-chrome3d]');
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      io.unobserve(e.target);
      const c = e.target as HTMLCanvasElement;
      mountChrome(c, c.dataset.mode as any, c.dataset.src);
    }
  }, { rootMargin: '200px' });
  canvases.forEach((c) => io.observe(c));
</script>
