---
import Icon from './Icon.astro';
import type { Film } from '../data/site';
interface Props { film: Film; brand: string; hue: number; large?: boolean }
const { film, brand, hue, large = false } = Astro.props;
---
<div class:list={['fp', { 'fp--large': large }]} style={`--h:${hue}`}>
  {film.video ? (
    <video src={film.video} controls playsinline preload="metadata"></video>
  ) : (
    <div class="fp__poster">
      <span class="fp__brand">{brand}</span>
      <span class="fp__play"><Icon name="play" size={large ? 22 : 14} /></span>
      <span class="fp__dur">{film.duration}</span>
      {large && <span class="placeholder-note fp__note">Film placeholder: add the video file in src/data/site.ts</span>}
    </div>
  )}
</div>
<style>
  .fp { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: #000; }
  .fp video { width: 100%; height: 100%; object-fit: cover; }
  .fp__poster { position: absolute; inset: 0; display: grid; place-items: center;
    background: radial-gradient(60% 80% at 75% 20%, hsl(var(--h) 70% 55% / .5), transparent 60%), radial-gradient(50% 60% at 15% 90%, hsl(var(--h) 60% 35% / .6), transparent 60%), linear-gradient(160deg, hsl(var(--h) 40% 12%), #07060b 70%); }
  .fp__brand { position: absolute; left: 20px; top: 16px; font-weight: 600; letter-spacing: -.03em; color: rgba(255,255,255,.7); }
  .fp__play { width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,.92); color: #120e1c; box-shadow: 0 0 40px rgba(142,108,239,.7); }
  .fp--large .fp__play { width: 80px; height: 80px; }
  .fp__dur { position: absolute; right: 14px; bottom: 14px; font-size: 12px; padding: 3px 8px; border-radius: 6px; background: rgba(7,6,11,.7); color: var(--text-2); }
  .fp__note { position: absolute; left: 16px; bottom: 14px; }
</style>
