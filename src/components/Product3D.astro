---
// 3D product showcase (Djalil’s cosmetic tube), turning on its own. Shipped as embedded glTF JSON so any static host serves it.
interface Props { src?: string }
const { src = '/3d/cosmetic.json' } = Astro.props;
---
<div class="p3d">
  <canvas data-product3d data-src={src} aria-hidden="true"></canvas>
</div>
<style>
  .p3d { position: relative; width: 100%; height: 100%; min-height: 220px; opacity: 0; transition: opacity 1s var(--ease); }
  .p3d:global(.is-ready) { opacity: 1; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: pan-y; }
</style>
<script>
  import { mountProduct } from '../scripts/product3d';
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      io.unobserve(e.target);
      const c = e.target as HTMLCanvasElement;
      mountProduct(c, c.dataset.src!).catch((err) => console.warn('[ovnistudio] 3D product failed to load', err));
    }
  }, { rootMargin: '200px' });
  document.querySelectorAll<HTMLCanvasElement>('canvas[data-product3d]').forEach((c) => io.observe(c));
</script>
