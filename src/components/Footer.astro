---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { ui, t, href, type Lang } from '../i18n';
import { studio, services } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const quick = [
  { l: ui.nav.services, p: '/services' },
  { l: ui.nav.work, p: '/work' },
  { l: ui.nav.about, p: '/about' },
  { l: { en: 'Process', fr: 'Méthode' }, p: '/process' },
  { l: { en: 'Reviews', fr: 'Avis' }, p: '/reviews' },
  { l: { en: 'Blog', fr: 'Blog' }, p: '/blog' },
  { l: { en: 'FAQ', fr: 'FAQ' }, p: '/faq' },
  { l: { en: 'Brand kit', fr: 'Kit de marque' }, p: '/brand' },
];
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo />
        <p class="muted small">{t(ui.footer.blurb, lang)}</p>
        <a class="btn btn--primary btn--sm" href={href('/contact', lang)}>
          {t(ui.nav.cta, lang)} <span class="btn__icon"><Icon name="half" size={10} /></span>
        </a>
      </div>
      <div class="footer__cols">
        <div>
          <h4>{t(ui.footer.quick, lang)}</h4>
          {quick.map((q) => <a href={href(q.p, lang)}>{t(q.l, lang)}</a>)}
        </div>
        <div>
          <h4>{t(ui.footer.services, lang)}</h4>
          {services.map((s) => <a href={href(`/services/${s.slug}`, lang)}>{t(s.title, lang)}</a>)}
        </div>
        <div>
          <h4>{t(ui.footer.contact, lang)}</h4>
          <a href={`mailto:${studio.email}`}>{studio.email}</a>
          <a href={`tel:${studio.phone.replace(/\s/g, '')}`}>{studio.phone}</a>
        </div>
        <div>
          <h4>{t(ui.footer.socials, lang)}</h4>
          {studio.socials.map((s) => <a href={s.url} target="_blank" rel="noopener">{s.name}</a>)}
        </div>
        <div>
          <h4>{t(ui.footer.legal, lang)}</h4>
          <a href={href('/privacy', lang)}>{fr ? 'Confidentialité' : 'Privacy'}</a>
          <a href={href('/terms', lang)}>{fr ? 'Conditions' : 'Terms'}</a>
        </div>
      </div>
    </div>
    <div class="footer__bottom small">
      <span>© {year} Ovnistudio. {t(ui.footer.rights, lang)}</span>
      <span>{studio.languages.join(' · ')}</span>
    </div>
  </div>
  <div class="footer__word" aria-hidden="true">OVNISTUDIO</div>
</footer>

<style>
  .footer { position: relative; border-top: 1px solid var(--line); padding-top: 72px; overflow: hidden; background: linear-gradient(180deg, transparent, rgba(42, 21, 80, 0.22)); }
  .footer__top { display: grid; grid-template-columns: 1.1fr 3fr; gap: 48px; }
  .footer__brand { display: grid; gap: 16px; align-content: start; justify-items: start; max-width: 260px; }
  .footer__cols { display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px; }
  .footer__cols div { display: grid; gap: 10px; align-content: start; font-size: 14px; color: var(--text-2); }
  .footer__cols a:hover { color: var(--text); }
  h4 { font-size: 13px; font-weight: 500; color: var(--text); margin-bottom: 6px; }
  .footer__bottom { display: flex; justify-content: space-between; gap: 16px; margin-top: 64px; padding: 20px 0; border-top: 1px solid var(--line); color: var(--text-3); }
  .footer__word {
    font-family: 'Unbounded', var(--font); font-size: clamp(34px, 10.4vw, 160px); font-weight: 800; letter-spacing: -0.02em; line-height: 0.9; text-align: center;
    margin-top: 16px; margin-bottom: -0.14em; white-space: nowrap;
    background: linear-gradient(180deg, rgba(201, 184, 245, 0.55) 0%, rgba(75, 42, 138, 0.25) 55%, transparent 90%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  @media (max-width: 1000px) {
    .footer__top { grid-template-columns: 1fr; }
    .footer__cols { grid-template-columns: repeat(3, 1fr); row-gap: 36px; }
  }
  @media (max-width: 560px) {
    .footer__cols { grid-template-columns: repeat(2, 1fr); }
    .footer__bottom { flex-direction: column; }
  }
</style>
