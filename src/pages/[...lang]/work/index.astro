---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import WorkCard from '../../../components/WorkCard.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { cases } from '../../../data/site';
import { langPaths, ui, t, type Lang } from '../../../i18n';
export function getStaticPaths() { return langPaths(); }
const { lang } = Astro.props as { lang: Lang };
---
<Base lang={lang} title={t(ui.nav.work, lang)} description={t(ui.sections.work.sub, lang)}>
  <PageHero lang={lang} tag={t(ui.sections.work.tag, lang)} title={t(ui.sections.work.title, lang)} sub={t(ui.sections.work.sub, lang)} crumbs={[{ label: t(ui.nav.work, lang), path: '/work' }]} />
  <section class="section" style="padding-top:24px">
    <div class="container grid">{cases.map((c) => <WorkCard c={c} lang={lang} />)}</div>
  </section>
  <CtaBand lang={lang} />
</Base>
<style>
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 48px 24px; }
  @media (max-width: 700px) { .grid { grid-template-columns: 1fr; } }
</style>
