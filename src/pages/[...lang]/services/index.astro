---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Services from '../../../components/home/Services.astro';
import Process from '../../../components/home/Process.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { langPaths, ui, t, type Lang } from '../../../i18n';
export function getStaticPaths() { return langPaths(); }
const { lang } = Astro.props as { lang: Lang };
---
<Base lang={lang} title={t(ui.nav.services, lang)} description={t(ui.sections.services.sub, lang)}>
  <PageHero lang={lang} tag={t(ui.sections.services.tag, lang)} title={t(ui.sections.services.title, lang)} sub={t(ui.sections.services.sub, lang)} crumbs={[{ label: t(ui.nav.services, lang), path: '/services' }]} />
  <Services lang={lang} asPage />
  <Process lang={lang} />
  <CtaBand lang={lang} />
</Base>
