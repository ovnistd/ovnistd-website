---
import Base from '../../../../layouts/Base.astro';
import PageHero from '../../../../components/PageHero.astro';
import Icon from '../../../../components/Icon.astro';
import CtaBand from '../../../../components/CtaBand.astro';
import { services, platforms } from '../../../../data/site';
import { langPaths, ui, t, href, type Lang } from '../../../../i18n';
export function getStaticPaths() {
  return langPaths(platforms.map((p) => ({ params: { platform: p.slug }, props: { platform: p } })));
}
const { lang, platform } = Astro.props as { lang: Lang; platform: (typeof platforms)[number] };
const web = services[0];
const fr = lang === 'fr';
const others = platforms.filter((p) => p.slug !== platform.slug);
---
<Base lang={lang} title={`${platform.name} · ${t(web.title, lang)}`} description={t(platform.body, lang)}>
  <PageHero lang={lang} tag={t(web.title, lang)} title={`${platform.name}\n${t(platform.tagline, lang)}`} sub={t(platform.body, lang)}
    crumbs={[{ label: t(ui.nav.services, lang), path: '/services' }, { label: t(web.title, lang), path: '/services/website-creation' }, { label: platform.name, path: `/services/website-creation/${platform.slug}` }]}>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:8px">
      <a class="btn btn--primary" href={href('/contact', lang)}>{t(ui.hero.cta1, lang)} <span class="btn__icon"><Icon name="half" size={10} /></span></a>
    </div>
  </PageHero>
  <section class="section" style="padding-top:24px">
    <div class="container grid">
      <div class="card box" data-reveal>
        <h2 class="h3">{fr ? 'Idéal pour' : 'Best for'}</h2>
        <ul>{t(platform.bestFor, lang).map((b) => <li><span class="ok"><Icon name="check" size={12} /></span>{b}</li>)}</ul>
      </div>
      <div class="card box" data-reveal>
        <h2 class="h3">{t(ui.common.deliverables, lang)}</h2>
        <ul>{t(web.deliverables, lang).map((b) => <li><span class="ok"><Icon name="check" size={12} /></span>{b}</li>)}</ul>
      </div>
      <div class="card box" data-reveal>
        <h2 class="h3">{fr ? 'Autres plateformes' : 'Other platforms'}</h2>
        <ul>{others.map((o) => <li><a href={href(`/services/website-creation/${o.slug}`, lang)}>{o.name} <Icon name="arrow" size={14} /></a></li>)}</ul>
      </div>
    </div>
  </section>
  <CtaBand lang={lang} />
</Base>
<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .box { padding: 28px; display: grid; gap: 12px; align-content: start; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: flex; gap: 12px; align-items: center; padding: 11px 0; border-bottom: 1px dashed var(--line); color: var(--text-2); }
  li:last-child { border: 0; }
  li a { display: flex; gap: 8px; align-items: center; } li a:hover { color: var(--text); }
  .ok { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; background: #fff; color: #120e1c; flex: none; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
</style>
