---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Stats from '../../components/home/Stats.astro';
import CtaBand from '../../components/CtaBand.astro';
import { reviews } from '../../data/site';
import { langPaths, ui, t, type Lang } from '../../i18n';
export function getStaticPaths() { return langPaths(); }
const { lang } = Astro.props as { lang: Lang };
---
<Base lang={lang} title={t(ui.sections.reviews.tag, lang)} description={t(ui.sections.reviews.sub, lang)}>
  <PageHero lang={lang} tag={t(ui.sections.reviews.tag, lang)} title={t(ui.sections.reviews.title, lang)} sub={t(ui.sections.reviews.sub, lang)} crumbs={[{ label: t(ui.sections.reviews.tag, lang), path: '/reviews' }]} />
  <Stats lang={lang} />
  <section class="section">
    <div class="container wall">
      {reviews.map((r) => (
        <figure class="card r" data-reveal>
          <div class="stars">{Array.from({ length: 5 }, () => <Icon name="star" size={14} />)}</div>
          <blockquote>{t(r.quote, lang)}</blockquote>
          <figcaption><strong>{r.name}</strong><small>{r.role}</small></figcaption>
        </figure>
      ))}
    </div>
  </section>
  <CtaBand lang={lang} />
</Base>
<style>
  .wall { columns: 3 300px; column-gap: 16px; }
  .r { break-inside: avoid; margin: 0 0 16px; padding: 28px; display: grid; gap: 16px; }
  .stars { display: flex; gap: 2px; color: var(--purple-4); }
  blockquote { margin: 0; font-size: 16px; line-height: 1.6; }
  figcaption { display: grid; font-size: 14px; padding-top: 16px; border-top: 1px solid var(--line); }
  small { color: var(--text-3); }
</style>
