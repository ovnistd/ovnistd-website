---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Stats from '../../components/home/Stats.astro';
import Reviews from '../../components/home/Reviews.astro';
import CtaBand from '../../components/CtaBand.astro';
import { langPaths, ui, t, type Lang } from '../../i18n';
export function getStaticPaths() { return langPaths(); }
const { lang } = Astro.props as { lang: Lang };
---
<Base lang={lang} title={t(ui.sections.reviews.tag, lang)} description={t(ui.sections.reviews.sub, lang)}>
  <PageHero lang={lang} tag={t(ui.sections.reviews.tag, lang)} title={t(ui.sections.reviews.title, lang)} sub={t(ui.sections.reviews.sub, lang)} crumbs={[{ label: t(ui.sections.reviews.tag, lang), path: '/reviews' }]} />
  <Reviews lang={lang} head={false} />
  <Stats lang={lang} />
  <CtaBand lang={lang} />
</Base>
