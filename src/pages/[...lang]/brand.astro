---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import Logo from '../../components/Logo.astro';
import Icon from '../../components/Icon.astro';
import { brandColors } from '../../data/site';
import { langPaths, type Lang } from '../../i18n';
export function getStaticPaths() { return langPaths(); }
const { lang } = Astro.props as { lang: Lang };
const fr = lang === 'fr';
---
<Base lang={lang} title={fr ? 'Kit de marque' : 'Brand kit'} description={fr ? 'Logo, couleurs et typographie Ovnistudio.' : 'Ovnistudio logo, colors and typography.'}>
  <PageHero lang={lang} tag={fr ? 'Kit de marque' : 'Brand kit'} title={fr ? 'Ovnistudio,\nmode d’emploi' : 'Ovnistudio\nbrand kit'} sub={fr ? 'Logo, couleurs et typographie pour la presse et les partenaires.' : 'Logo, colors and typography for press and partners.'} crumbs={[{ label: fr ? 'Kit de marque' : 'Brand kit', path: '/brand' }]}>
    <div><a class="btn btn--primary" href="/brand/ovnistudio-brand-kit.zip" download>{fr ? 'Télécharger le kit' : 'Download kit'} <Icon name="download" size={14} /></a> <span class="placeholder-note">{fr ? 'Fichier à ajouter dans public/brand/' : 'Add the file in public/brand/'}</span></div>
  </PageHero>
  <section class="section" style="padding-top:0">
    <div class="container">
      <SectionHead tag="Logo" title={fr ? 'Le logo' : 'The logo'} />
      <div class="logos">
        <div class="card lbox"><Logo /></div>
        <div class="lbox lbox--light"><Logo /></div>
      </div>
      <SectionHead tag={fr ? 'Couleurs' : 'Colors'} title={fr ? 'La palette' : 'The palette'} />
      <div class="colors">{brandColors.map((c) => (
        <div class="sw"><span style={`background:${c.hex}`}></span><strong>{c.name}</strong><code>{c.hex}</code></div>
      ))}</div>
      <SectionHead tag={fr ? 'Typographie' : 'Typography'} title="Inter" />
      <div class="card type">
        <span class="display">Aa Bb Cc</span>
        <p class="muted">Inter Regular 400 · Medium 500 · Semibold 600 — {fr ? 'Titres en Medium, interlettrage −4 %.' : 'Headlines in Medium, letter-spacing −4%.'}</p>
      </div>
    </div>
  </section>
</Base>
<style>
  .logos { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 96px; }
  .lbox { height: 220px; display: grid; place-items: center; border-radius: var(--radius); transform: scale(1); }
  .lbox :global(.logo) { transform: scale(1.8); }
  .lbox--light { background: #f4f1fa; color: #120e1c; }
  .colors { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; margin-bottom: 96px; }
  .sw { display: grid; gap: 4px; font-size: 14px; }
  .sw span { aspect-ratio: 1; border-radius: 14px; border: 1px solid var(--line-2); margin-bottom: 8px; }
  code { color: var(--text-3); font-size: 13px; }
  .type { padding: 40px; display: grid; gap: 12px; }
  @media (max-width: 800px) { .logos { grid-template-columns: 1fr; } .colors { grid-template-columns: repeat(3, 1fr); } }
</style>
