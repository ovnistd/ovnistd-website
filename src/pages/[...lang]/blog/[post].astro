---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { posts } from '../../../data/site';
import { langPaths, ui, t, type Lang } from '../../../i18n';
export function getStaticPaths() { return langPaths(posts.map((p) => ({ params: { post: p.slug }, props: { p } }))); }
const { lang, p } = Astro.props as { lang: Lang; p: (typeof posts)[number] };
---
<Base lang={lang} title={t(p.title, lang)} description={t(p.excerpt, lang)}>
  <PageHero lang={lang} tag={`${p.date} · ${p.minutes} ${t(ui.common.minRead, lang)}`} title={t(p.title, lang)} sub={t(p.excerpt, lang)} crumbs={[{ label: 'Blog', path: '/blog' }, { label: t(p.title, lang), path: `/blog/${p.slug}` }]} />
  <section class="section" style="padding-top:0"><div class="container prose">{t(p.body, lang).map((x) => <p>{x}</p>)}</div></section>
  <CtaBand lang={lang} />
</Base>
