---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Icon from '../../../components/Icon.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { posts } from '../../../data/site';
import { langPaths, ui, t, href, type Lang } from '../../../i18n';
export function getStaticPaths() { return langPaths(); }
const { lang } = Astro.props as { lang: Lang };
const fr = lang === 'fr';
---
<Base lang={lang} title="Blog" description={fr ? 'Notes du studio sur le web, la marque, la 3D et l’IA.' : 'Studio notes on web, brand, 3D and AI.'}>
  <PageHero lang={lang} tag="Blog" title={fr ? 'Notes du studio' : 'Studio notes'} sub={fr ? 'Ce qu’on apprend en faisant : web, marque, 3D et IA.' : 'What we learn by doing: web, brand, 3D and AI.'} crumbs={[{ label: 'Blog', path: '/blog' }]} />
  <section class="section" style="padding-top:0">
    <div class="container grid">
      {posts.map((p, i) => (
        <a class="card post" href={href(`/blog/${p.slug}`, lang)} data-reveal>
          <div class="post__img" style={`--h:${250 + i * 25}`}></div>
          <div class="post__body">
            <span class="small" style="color:var(--text-3)">{p.date} · {p.minutes} {t(ui.common.minRead, lang)}</span>
            <h2 class="h3">{t(p.title, lang)}</h2>
            <p class="muted small">{t(p.excerpt, lang)}</p>
            <span class="more small">{t(ui.common.readMore, lang)} <Icon name="arrow" size={14} /></span>
          </div>
        </a>
      ))}
    </div>
  </section>
  <CtaBand lang={lang} />
</Base>
<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .post { display: grid; transition: transform .4s var(--ease); }
  .post:hover { transform: translateY(-3px); }
  .post__img { aspect-ratio: 16/10; background: radial-gradient(60% 80% at 70% 20%, hsl(var(--h) 70% 55% / .5), transparent 60%), linear-gradient(160deg, hsl(var(--h) 40% 14%), #07060b); border-bottom: 1px solid var(--line); }
  .post__body { padding: 22px; display: grid; gap: 10px; }
  .more { display: inline-flex; gap: 6px; align-items: center; color: var(--purple-4); }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
</style>
