---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { studio } from '../../../data/site';
import { langPaths, ui, t, type Lang } from '../../../i18n';
export function getStaticPaths() { return langPaths([{ params: { founder: studio.founder.slug }, props: {} }]); }
const { lang } = Astro.props as { lang: Lang };
const f = studio.founder;
const fr = lang === 'fr';
---
<Base lang={lang} title={f.name} description={t(f.role, lang)}>
  <PageHero lang={lang} tag={t(f.role, lang)} title={f.name} sub={t(f.bio, lang)}
    crumbs={[{ label: t(ui.nav.about, lang), path: '/about' }, { label: f.name, path: `/about/${f.slug}` }]} />
  <section class="section" style="padding-top:0">
    <div class="container prose">
      <h2>{fr ? 'Parcours' : 'Background'}</h2>
      <p>{fr ? '[Formation, expériences, clients marquants.]' : '[Education, experience, notable clients.]'}</p>
      <h2>{fr ? 'Pourquoi Ovnistudio' : 'Why Ovnistudio'}</h2>
      <p>{fr ? '[Ce qui vous a poussé à créer le studio et votre vision.]' : '[What made you start the studio and your vision for it.]'}</p>
    </div>
  </section>
  <CtaBand lang={lang} />
</Base>
