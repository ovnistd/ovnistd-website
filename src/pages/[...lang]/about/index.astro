---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Icon from '../../../components/Icon.astro';
import IntroVideo from '../../../components/home/IntroVideo.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { story } from '../../../data/site';
import { langPaths, ui, t, href, type Lang } from '../../../i18n';
export function getStaticPaths() { return langPaths(); }
const { lang } = Astro.props as { lang: Lang };
const fr = lang === 'fr';
---
<Base lang={lang} title={t(ui.nav.about, lang)} description={fr ? 'De courts métrages en famille à un studio 3D pour l’e-commerce : l’histoire d’Ovnistudio.' : 'From family short films to a 3D studio for e-commerce: the Ovnistudio story.'}>
  <PageHero lang={lang} tag={t(ui.nav.about, lang)} title={fr ? 'Une passion\nnée à 9 ans' : 'A passion that\nstarted at 9'}
    sub={fr ? 'Ovnistudio, c’est l’histoire d’un enfant qui filmait des courts métrages en famille et qui a fait de la 3D son métier. Depuis 2022.' : 'Ovnistudio began with a kid filming short movies with family and grew into a 3D career. Since 2022.'}
    crumbs={[{ label: t(ui.nav.about, lang), path: '/about' }]} />
  <section class="section" style="padding-top:24px">
    <div class="container">
      <ol class="timeline">
        {story.map((s) => (
          <li class="tl" data-reveal>
            <span class="tl__year">{s.year}</span>
            <span class="tl__dot"></span>
            <div class="tl__card card">
              <h2 class="h3">{t(s.title, lang)}</h2>
              <p class="muted">{t(s.body, lang)}</p>
              {s.link && <a class="tl__link small" href={s.link.url} target="_blank" rel="noopener"><Icon name="play" size={12} /> {t(s.link.label, lang)}</a>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <IntroVideo lang={lang} />
  <CtaBand lang={lang} />
</Base>
<style>
  .timeline { list-style: none; margin: 0 auto; padding: 0; max-width: 860px; display: grid; gap: 20px; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 112px; top: 8px; bottom: 8px; width: 1px; background: linear-gradient(180deg, transparent, rgba(201,184,245,.45) 8%, rgba(201,184,245,.45) 92%, transparent); }
  .tl { display: grid; grid-template-columns: 90px 44px 1fr; align-items: start; }
  .tl__year { font-size: 28px; font-weight: 500; letter-spacing: -.04em; line-height: 1; padding-top: 22px; text-align: right; background: linear-gradient(180deg, #fff, #a993e0); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .tl__dot { justify-self: center; margin-top: 30px; width: 12px; height: 12px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #fff, #c9b8f5 45%, #4b2a8a); box-shadow: 0 0 14px rgba(142,108,239,.8); position: relative; z-index: 1; }
  .tl__card { padding: 22px 24px; display: grid; gap: 8px; }
  .tl__link { display: inline-flex; gap: 8px; align-items: center; color: var(--purple-4); justify-self: start; margin-top: 4px; position: relative; }
  .tl__link:hover { color: var(--text); }
  @media (max-width: 640px) {
    .timeline::before { left: 7px; }
    .tl { grid-template-columns: 16px 1fr; gap: 6px 12px; }
    .tl__year { grid-column: 2; text-align: left; padding: 0; font-size: 22px; }
    .tl__dot { grid-row: 1; grid-column: 1; margin-top: 6px; }
    .tl__card { grid-column: 2; }
  }
</style>
