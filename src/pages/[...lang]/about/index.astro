---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import SectionHead from '../../../components/SectionHead.astro';
import Stats from '../../../components/home/Stats.astro';
import WhyUs from '../../../components/home/WhyUs.astro';
import Icon from '../../../components/Icon.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { studio } from '../../../data/site';
import { langPaths, ui, t, href, type Lang } from '../../../i18n';
export function getStaticPaths() { return langPaths(); }
const { lang } = Astro.props as { lang: Lang };
const fr = lang === 'fr';
---
<Base lang={lang} title={t(ui.nav.about, lang)} description={fr ? 'Ovnistudio, studio créatif indépendant.' : 'Ovnistudio, an independent creative studio.'}>
  <PageHero lang={lang} tag={t(ui.nav.about, lang)} title={fr ? 'Un studio venu\nd’ailleurs' : 'A studio from\nanother planet'}
    sub={fr ? `Ovnistudio est un studio créatif indépendant basé à ${studio.city}, depuis ${studio.since}. [Racontez ici l’histoire du studio.]` : `Ovnistudio is an independent creative studio based in ${studio.city}, since ${studio.since}. [Tell the studio's story here.]`}
    crumbs={[{ label: t(ui.nav.about, lang), path: '/about' }]} />
  <Stats lang={lang} />
  <section class="section">
    <div class="container">
      <SectionHead tag={fr ? 'Fondateur' : 'Founder'} title={studio.founder.name} sub={t(studio.founder.role, lang)} />
      <a class="card founder" href={href(`/about/${studio.founder.slug}`, lang)} data-reveal>
        <span class="founder__photo">{fr ? 'Photo' : 'Photo'}</span>
        <div><p class="muted">{t(studio.founder.bio, lang)}</p><span class="more small">{t(ui.common.learnMore, lang)} <Icon name="arrow" size={14} /></span></div>
      </a>
    </div>
  </section>
  <WhyUs lang={lang} />
  <CtaBand lang={lang} />
</Base>
<style>
  .founder { display: grid; grid-template-columns: 200px 1fr; gap: 32px; padding: 24px; align-items: center; max-width: 820px; }
  .founder__photo { aspect-ratio: 1; border-radius: 12px; display: grid; place-items: center; color: var(--text-3); font-size: 13px; background: linear-gradient(160deg, #2a1550, #0c0913); border: 1px dashed var(--line-2); }
  .founder div { display: grid; gap: 16px; }
  .more { display: inline-flex; gap: 6px; align-items: center; color: var(--purple-4); }
  @media (max-width: 600px) { .founder { grid-template-columns: 1fr; } }
</style>
