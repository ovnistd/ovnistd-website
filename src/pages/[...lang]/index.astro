---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/home/Hero.astro';
import Stats from '../../components/home/Stats.astro';
import Services from '../../components/home/Services.astro';
import WhyUs from '../../components/home/WhyUs.astro';
import Work from '../../components/home/Work.astro';
import Process from '../../components/home/Process.astro';
import Reviews from '../../components/home/Reviews.astro';
import CtaBand from '../../components/CtaBand.astro';
import { langPaths, type Lang } from '../../i18n';

export function getStaticPaths() { return langPaths(); }
const { lang } = Astro.props as { lang: Lang };
const fr = lang === 'fr';
---
<Base
  lang={lang}
  title={fr ? 'Ovnistudio · Studio créatif : sites web, marques, 3D et films' : 'Ovnistudio · Creative studio for websites, brands, 3D and films'}
  description={fr
    ? 'Ovnistudio conçoit sites web, identités de marque, design graphique, médias créatifs, 3D et contenu IA pour les marques ambitieuses.'
    : 'Ovnistudio designs websites, brand identities, graphic design, creative media, 3D and AI content for ambitious brands.'}
>
  <Hero lang={lang} />
  <Stats lang={lang} />
  <Services lang={lang} />
  <WhyUs lang={lang} />
  <Work lang={lang} />
  <Process lang={lang} />
  <Reviews lang={lang} />
  <CtaBand lang={lang} />
</Base>
